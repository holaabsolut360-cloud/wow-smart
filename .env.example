NODE_ENV=development
PORT=3000
USE_SUPABASE_DB=false

# Supabase server-side auth verification
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase browser client
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SuperAdmin server-side credentials. Never expose these with VITE_.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-this-password
SUPERADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional email sending
RESEND_API_KEY=
EMAIL_FROM=WowSmart <onboarding@resend.dev>

# Subscription lifecycle (see server/services/SubscriptionService.ts)
TRIAL_DURATION_BUSINESS_DAYS=15
BILLING_CYCLE_DAYS=30

# Shared secret for the daily trial-expiry cron job.
# Set the same value here and in the Render Cron Job's Authorization header:
#   Authorization: Bearer <CRON_SECRET>
CRON_SECRET=replace-with-a-long-random-secret
