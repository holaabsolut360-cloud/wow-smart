NODE_ENV=development
PORT=3000
USE_SUPABASE_DB=false

# Supabase server-side auth verification
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase browser client
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SuperAdmin server-side credentials. Never expose these with VITE_.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-this-password
SUPERADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional email sending
RESEND_API_KEY=
